# Copiar a .env (no se commitea) y completar con los datos del proyecto real.
# Firebase Console > Configuración del proyecto > Tus apps > App web.
# En `npm run dev` estos valores se reemplazan por los de .env.development (emuladores).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_USE_EMULATORS=false

# WhatsApp de destino, formato 549XXXXXXXXXX (sin +, espacios ni guiones)
VITE_WHATSAPP=

# Cloudinary: nombre de la cuenta y upload preset sin firma (ver CLAUDE.md)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
