# Se carga automáticamente con `npm run dev` y tiene prioridad sobre .env.
# Sin secretos: apunta al Emulator Suite con un proyecto demo-* (nunca toca producción).
# Para overrides personales usá .env.development.local (no se commitea).

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-kamae.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-kamae
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_MEASUREMENT_ID=

VITE_USE_EMULATORS=true

VITE_WHATSAPP=5490000000000

# Cuenta real (el cloud name es público; las imágenes del seed son las de ejemplo de la cuenta)
VITE_CLOUDINARY_CLOUD_NAME=uesxf3on
# Upload preset sin firma (crearlo en Cloudinary con este nombre; ver CLAUDE.md)
VITE_CLOUDINARY_UPLOAD_PRESET=kamae_productos
