rules_version = '2';

// Reglas de Kamae. La seguridad real está acá: la ruta privada de React es solo UX.
// Tests: tests/firestore.rules.test.js (`npm run test:rules`).
//
// Roles:
//  - Admin: UID con documento en /admins/{uid} (se da de alta desde la Firebase Console).
//    Ve y edita todo, y aprueba/suspende vendedores.
//  - Vendedor: se registra solo (/usuarios/{uid} en estado 'pendiente'); puede publicar
//    cuando un admin lo aprueba Y verificó su email. Solo toca SUS productos.
// NO usar `request.auth != null` como criterio de permisos: cualquiera puede crearse una cuenta.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function emailVerificado() {
      return request.auth.token.get('email_verified', false) == true;
    }

    function esVendedor() {
      return request.auth != null
        && emailVerificado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == 'aprobado';
    }

    function puedePublicar() {
      return esAdmin() || esVendedor();
    }

    // Estructura y tipos de `productos` (ver CLAUDE.md). Un borrador puede tener datos
    // sin completar (categoría '', precio null, sin disciplina ni imágenes).
    // Los elementos de variantes/imagenes no se validan uno a uno (las reglas no tienen
    // bucles); se limita su cantidad.
    function productoValido(d) {
      let campos = ['nombre', 'slug', 'descripcion', 'disciplina', 'categoria', 'precio',
        'moneda', 'disponibilidad', 'tiempoProduccion', 'variantes', 'visible',
        'imagenes', 'whatsapp', 'vendedorUid', 'fechaCreacion', 'fechaActualizacion'];
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos)
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.slug is string && d.slug.size() <= 100
        && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && d.descripcion is string && d.descripcion.size() <= 5000
        && d.disciplina is list && d.disciplina.hasOnly(['kendo', 'iaido'])
        && d.categoria in ['', 'shinai', 'bokken', 'iaito', 'tsuba', 'bogu', 'indumentaria', 'accesorios']
        && (d.precio == null || (d.precio is number && d.precio >= 0))
        && d.moneda in ['ARS', 'USD']
        && d.disponibilidad in ['disponible', 'agotado', 'a_pedido']
        && d.tiempoProduccion is string && d.tiempoProduccion.size() <= 50
        && d.variantes is list && d.variantes.size() <= 30
        && d.visible is bool
        && d.imagenes is list && d.imagenes.size() <= 10
        // WhatsApp de contacto del producto: '' (borrador) o 549 + 10 dígitos.
        && d.whatsapp is string
        && (d.whatsapp == '' || d.whatsapp.matches('^549[0-9]{10}$'))
        && d.vendedorUid is string
        && d.fechaCreacion is timestamp
        && d.fechaActualizacion is timestamp
        // Solo se publica un producto completo (mismo criterio que utils/completitud.js).
        && (d.visible == false || productoCompleto(d));
    }

    function productoCompleto(d) {
      return d.descripcion.size() > 0
        && d.disciplina.size() > 0
        && d.categoria != ''
        && d.precio != null
        && d.imagenes.size() > 0
        && d.whatsapp != '';
    }

    match /admins/{uid} {
      // Cada usuario puede consultar solo su propio documento (para saber si es admin).
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Perfil y estado de cada vendedor.
    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      // Registro: el propio usuario crea su perfil, SIEMPRE como 'pendiente'.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'estado', 'emailVerificado', 'fechaSolicitud', 'fechaActualizacion'])
        && request.resource.data.keys().hasAll(['nombre', 'email', 'estado', 'emailVerificado', 'fechaSolicitud', 'fechaActualizacion'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.emailVerificado == emailVerificado()
        && request.resource.data.fechaSolicitud == request.time
        && request.resource.data.fechaActualizacion == request.time;

      // El usuario solo puede refrescar `emailVerificado`, y con el valor real de su token.
      // El admin solo cambia `estado` (nunca nombre ni email).
      allow update: if (
          request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerificado', 'fechaActualizacion'])
          && request.resource.data.emailVerificado == emailVerificado()
          && request.resource.data.fechaActualizacion == request.time
        ) || (
          esAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'fechaActualizacion'])
          && request.resource.data.estado in ['pendiente', 'aprobado', 'rechazado', 'suspendido']
          && request.resource.data.fechaActualizacion == request.time
        );

      allow delete: if esAdmin();
    }

    // Registro de slugs (URLs) para garantizar que sean únicos: un vendedor no puede
    // listar productos ajenos (borradores), así que no podría chequearlo de otra forma.
    // Se crea en el mismo batch que el producto; si el slug ya existe, el batch falla.
    match /slugs/{slug} {
      allow get: if request.auth != null;
      allow create: if puedePublicar()
        && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.keys().hasOnly(['productoId', 'vendedorUid'])
        && request.resource.data.keys().hasAll(['productoId', 'vendedorUid'])
        && request.resource.data.vendedorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/productos/$(request.resource.data.productoId)).data.slug == slug;
      allow delete: if esAdmin()
        || (esVendedor() && resource.data.vendedorUid == request.auth.uid);
      allow list, update: if false;
    }

    match /productos/{id} {
      // Público: solo visibles (las queries públicas deben filtrar `visible == true`).
      // Cada vendedor ve además sus borradores (queries con `vendedorUid == uid`).
      allow read: if resource.data.visible == true
        || esAdmin()
        || (request.auth != null && resource.data.vendedorUid == request.auth.uid);

      // Alta: el producto queda a nombre de quien lo crea, con su slug registrado en el mismo batch.
      allow create: if puedePublicar()
        && productoValido(request.resource.data)
        && request.resource.data.vendedorUid == request.auth.uid
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.fechaActualizacion == request.time
        && getAfter(/databases/$(database)/documents/slugs/$(request.resource.data.slug)).data.productoId == id;

      // Edición: el admin cualquiera; un vendedor solo los suyos. Dueño y slug no cambian.
      allow update: if (esAdmin() || (esVendedor() && resource.data.vendedorUid == request.auth.uid))
        && productoValido(request.resource.data)
        && request.resource.data.vendedorUid == resource.data.vendedorUid
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.fechaCreacion == resource.data.fechaCreacion
        && request.resource.data.fechaActualizacion == request.time;

      allow delete: if esAdmin()
        || (esVendedor() && resource.data.vendedorUid == request.auth.uid);
    }

    // Todo lo demás queda cerrado por defecto.
  }
}
